<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub Actions uploads a .zip containing ParamLens.exe; SignPath signs the PE file with Authenticode. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ParamLens.exe" product-name="ParamLens">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
